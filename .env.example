# ==============================================================================
# SmileCare OS — Real AI Assistant Environment Configuration
# ==============================================================================
# Instructions:
# 1. Copy this file to .env or pass these as build-time flags using:
#    flutter run -d chrome --dart-define=AI_API_KEY=your_key_here --dart-define=AI_MODEL=gpt-4o-mini
# 2. Or configure them interactively in the app via the ⚙️ icon in the AI Assistant header.
# 3. NEVER commit your actual API keys to GitHub or public repositories.
# ==============================================================================

# Primary LLM API Key (OpenAI, Groq, Together, DeepSeek, or Gemini)
AI_API_KEY=sk-proj-your-openai-api-key-here

# API Base URL (OpenAI-compatible endpoint)
# Examples:
# OpenAI:   https://api.openai.com/v1
# Groq:     https://api.groq.com/openai/v1
# Together: https://api.together.xyz/v1
# Ollama:   http://localhost:11434/v1
# Proxy:    http://localhost:3000/api/chat
AI_BASE_URL=https://api.openai.com/v1

AI_MODEL=gpt-4o-mini

# ==============================================================================
# SmileCare OS — Real Biometric Face Attendance & Geofence Configuration
# ==============================================================================
# Clinic Geofence Coordinates (Default Pune Clinic)
CLINIC_LATITUDE=18.52048
CLINIC_LONGITUDE=73.85672
CLINIC_RADIUS_METERS=50.0

# Biometric Engine Provider (e.g., aws_rekognition, azure_face, mediapipe, or demo)
# In REAL MODE, a real provider and endpoint are strictly required.
BIOMETRIC_PROVIDER=
BIOMETRIC_API_ENDPOINT=

# Backend Secure Proxy URL
BACKEND_URL=http://localhost:3000

# Biometric Consent Terms Version
BIOMETRIC_CONSENT_VERSION=1.0

